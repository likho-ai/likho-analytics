# Committed: no secrets here. Secrets for this environment live in .env.production.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.production, .env.production.local; a real environment variable wins.

LIKHO_ENV=production
LOG_LEVEL=INFO
HTTP_PORT=4070
GRPC_PORT=5070

# CLICKHOUSE_URL: in .env.production.local
NATS_URL=nats://nats:4222
MIGRATE_ON_START=true
RETENTION_DAYS=400
# The zone a day begins in (the company's). Empty = TZ, else UTC.
TIMEZONE=

CONSUMERS_ENABLED=true
CONSUMER_GROUP=likho-analytics
CONSUMER_START=all

# How long the start keeps trying to reach NATS before giving up.
NATS_CONNECT_TIMEOUT_SECONDS=120
# Metrics are always at GET /metrics. To also push them (OTLP/HTTP, e.g. the obs profile): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
