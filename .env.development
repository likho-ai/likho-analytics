# Committed: the local stack (likho-infra), no secrets. Your own changes go in .env.development.local
# (ignored by git). Read order: .env, .env.local, .env.development, .env.development.local; a real
# environment variable wins over all of them.

LIKHO_ENV=development
LOG_LEVEL=INFO
HTTP_PORT=4070
GRPC_PORT=5070

NATS_URL=nats://localhost:4222
CLICKHOUSE_URL=http://likho_analytics:likho_analytics@localhost:8123/likho_analytics
MIGRATE_ON_START=true
RETENTION_DAYS=400
# The zone a day begins in (the company's). Empty = TZ, else UTC.
TIMEZONE=

CONSUMERS_ENABLED=true
CONSUMER_GROUP=likho-analytics
# all = every event the streams still hold (a new installation catches up); new = from now on.
CONSUMER_START=all

# How long the start keeps trying to reach NATS before giving up.
NATS_CONNECT_TIMEOUT_SECONDS=120
# Metrics are always at GET /metrics. To also push them (OTLP/HTTP, e.g. the obs profile): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
